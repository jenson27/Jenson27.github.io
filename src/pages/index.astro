---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { Image } from "astro:assets";

const projects = await getCollection("project");
const featuredProject = projects.find((project) => project.slug === "project4")!;
const selectedProjects = ["project2", "project3"].map(
  (slug) => projects.find((project) => project.slug === slug)!
);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="grid gap-10 pt-4 pb-16 md:grid-cols-[0.95fr_1.05fr] md:items-center">
    <div>
      <p class="reveal font-mono-code text-sm uppercase tracking-[0.18em] text-primary mb-4" style="animation-delay:0ms">
        Jenson's portfolio
      </p>
      <h1 class="reveal font-display text-5xl md:text-6xl font-extrabold leading-[1.05] mb-5" style="animation-delay:90ms">
        Hey, I'm Jenson.
      </h1>
      <p class="reveal font-display text-2xl md:text-3xl font-semibold leading-snug mb-5" style="animation-delay:170ms">
        I build interactive tools and playful web experiences.
      </p>
      <p class="reveal text-base leading-relaxed text-base-content/70 max-w-[52ch] mb-8" style="animation-delay:250ms">
        From mini-games to a tool that turns video into ASCII animation, I enjoy making software people can explore and use.
      </p>
      <div class="reveal flex flex-wrap items-center gap-3" style="animation-delay:330ms">
        <a href="/projects" class="btn btn-primary">Explore my work</a>
        <a href="/cv" class="btn btn-ghost border border-base-content/15">View my CV</a>
      </div>
    </div>

    <a
      href={"/projects/" + createSlug(featuredProject.data.title, featuredProject.slug)}
      class="reveal group block overflow-hidden rounded-3xl border border-base-content/10 bg-base-200/60 shadow-2xl transition hover:-translate-y-1 hover:border-primary/40"
      style="animation-delay:200ms"
    >
      <div class="overflow-hidden">
        <Image
          src={featuredProject.data.thumbnail}
          width={800}
          height={600}
          format="webp"
          alt="ASCIIMotion terminal preview"
          class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        />
      </div>
      <div class="flex items-center justify-between gap-4 p-5">
        <div>
          <p class="font-mono-code text-xs uppercase tracking-[0.16em] text-primary mb-2">Featured project</p>
          <h2 class="font-display text-xl font-bold">{featuredProject.data.title}</h2>
          <p class="mt-1 text-sm text-base-content/65">Turn video into animated ASCII art.</p>
        </div>
        <span aria-hidden="true" class="text-2xl text-primary transition-transform group-hover:translate-x-1">↗</span>
      </div>
    </a>
  </section>

  <section class="pb-8">
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono-code text-xs uppercase tracking-[0.16em] text-base-content/50 mb-2">Selected work</p>
        <h2 class="font-display text-2xl font-bold">More things I've built</h2>
      </div>
      <a href="/projects" class="link link-hover shrink-0 text-sm text-base-content/60">View all</a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {selectedProjects.map((project) => (
        <a
          href={"/projects/" + createSlug(project.data.title, project.slug)}
          class="group overflow-hidden rounded-2xl border border-base-content/10 bg-base-200/30 transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl"
        >
          <div class="overflow-hidden">
            <Image
              src={project.data.thumbnail}
              width={750}
              height={422}
              format="webp"
              alt={project.data.title}
              class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <div class="p-5">
            <h3 class="font-display text-lg font-bold">{project.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-base-content/65">{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    animation: reveal-up 0.6s ease-out forwards;
  }

  @keyframes reveal-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
